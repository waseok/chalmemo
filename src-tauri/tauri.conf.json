{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "찰메모",
  "version": "0.1.21",
  "identifier": "com.waseok.chalmemo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "찰메모",
        "width": 380,
        "height": 520,
        "minWidth": 280,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "visible": true,
        "skipTaskbar": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    }
  },
  "plugins": {}
}
